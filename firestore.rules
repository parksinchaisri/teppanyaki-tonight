rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read a class document to validate the class code.
    match /classes/{classCode} {
      allow read: if true;
      // Allow first-time creation from the admin "Create new class" screen, but
      // never overwrite an existing class document this way.
      allow create: if !exists(/databases/$(database)/documents/classes/$(classCode));
      // Allow updates so the instructor dashboard can live-save the `settings`
      // object (PIN is verified client-side). No auth, by design for the classroom.
      allow update: if true;

      // Student writes their own result; leaderboard is public within the class.
      match /studentResults/{docId} {
        allow read: if true;
        allow create, update: if request.auth == null
          && request.resource.data.classCode == classCode
          && request.resource.data.bestAvgProfit is number
          && request.resource.data.studentName.size() >= 2
          && request.resource.data.studentName.size() <= 30;
        allow delete: if true;  // instructor "Reset Class Data" (PIN-gated client-side)
      }

      // Reflections: write-only from students; reads scoped to the class path
      // (anyone with the code can read — acceptable for a classroom tool).
      match /reflections/{docId} {
        allow create: if request.auth == null
          && request.resource.data.response.size() >= 10;
        allow read: if true;
        allow delete: if true;  // instructor "Reset Class Data" (PIN-gated client-side)
      }

      // Attempts: the permanent audit trail — one row per brand-new Simulate
      // run. Append-only by design; "Reset Class Data" deliberately leaves it
      // intact, so no delete rule here.
      match /attempts/{docId} {
        allow create: if request.auth == null
          && request.resource.data.challengeKey is string
          && request.resource.data.studentId is string
          && request.resource.data.attemptNumber is number;
        allow read: if true;
      }

      // Live session flow (phase, current challenge, timer, leaderboard view).
      // A single document per class holding orchestration state only — no
      // student data — so it follows the same open-classroom pattern.
      match /live/{docId} {
        allow read: if true;
        allow create, update: if true;
      }

      match /students/{studentId} {
        allow create, update: if true;
        allow read: if true;
      }
    }
  }
}
